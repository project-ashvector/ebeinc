[Unit]
Description=Safely admit approved Drive masters into local playback storage
After=allthings140radio-drive.service
Wants=allthings140radio-drive.service

[Service]
Type=oneshot
User=allthings140radio
Group=allthings140radio
ExecStart=/usr/bin/python3 /opt/allthings140radio-server/recover_playback_assets.py --apply --rclone-remote at140drive: --rclone-config /etc/allthings140radio/rclone.conf --ledger /srv/allthings140radio/data/recovery/playback-admission-latest.json
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/allthings140radio/data/recovery /srv/allthings140radio/data/music

