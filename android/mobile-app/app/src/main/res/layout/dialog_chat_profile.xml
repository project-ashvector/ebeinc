<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/panel"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="0.04"
        android:text="@string/chat_profile_title"
        android:textColor="@color/white"
        android:textSize="18sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/chat_name_hint"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/editProfileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/chat_input_background"
        android:hint="@string/chat_name_hint"
        android:inputType="textPersonName"
        android:maxLength="24"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textColorHint="@color/muted"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/chat_color_label"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/layoutColorSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnColorPurple"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/avatar_purple"
            android:text="P"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnColorCyan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/avatar_cyan"
            android:text="C"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnColorPink"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/avatar_pink"
            android:text="P"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnColorGreen"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/avatar_green"
            android:text="G"
            android:textColor="@color/white"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnColorOrange"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="4dp"
            android:background="@drawable/avatar_orange"
            android:text="O"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnProfileCancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_cyber"
            android:minHeight="48dp"
            android:text="@string/chat_close"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnProfileSave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/button_orange"
            android:minHeight="48dp"
            android:text="@string/chat_save_profile"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
