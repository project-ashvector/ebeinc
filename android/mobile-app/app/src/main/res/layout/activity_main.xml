<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Fixed full-screen background image -->
    <ImageView
        android:id="@+id/imgAppBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/app_background" />

    <!-- Dark translucent scrim to ensure text contrast while letting speaker art shine -->
    <View
        android:id="@+id/scrimBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim_dark" />

    <!-- Main UI Container -->
    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Bar -->
        <LinearLayout
            android:id="@+id/mainTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/top_bar"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:letterSpacing="0.10"
                    android:text="@string/station_tagline"
                    android:textColor="@color/muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings"
                android:padding="12dp"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <!-- Dynamic Screen Content Area -->
        <FrameLayout
            android:id="@+id/mainScreenContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- TAB 1: RADIO TAB -->
            <ScrollView
                android:id="@+id/scrollRadio"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/content_padding_horizontal"
                    android:paddingTop="12dp"
                    android:paddingEnd="@dimen/content_padding_horizontal"
                    android:paddingBottom="20dp">

                    <!-- TOP VISUALS CARD (Reworked: Title, Status, Live Visuals Video) -->
                    <LinearLayout
                        android:id="@+id/cardVisuals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/panel"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/txtVisualTrackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:gravity="center_horizontal"
                            android:maxLines="2"
                            android:text="@string/default_track_title"
                            android:textColor="@color/white"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/txtVisualStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:gravity="center_horizontal"
                            android:letterSpacing="0.10"
                            android:text="@string/ready_for_transmission"
                            android:textColor="@color/purple_neon"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <!-- 16:9 Looping Visuals Video View -->
                        <online.ebeinc.allthings140radio.VisualsVideoView
                            android:id="@+id/visualsVideoView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- LIVE TRACK INFO CARD -->
                    <LinearLayout
                        android:id="@+id/cardLiveInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/card_background"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/txtLiveBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/live_badge"
                            android:letterSpacing="0.08"
                            android:text="@string/live_ready"
                            android:textColor="@color/orange"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:letterSpacing="0.12"
                            android:text="@string/now_playing_label"
                            android:textColor="@color/purple_neon"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtNowPlaying"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-black"
                            android:maxLines="2"
                            android:text="@string/default_track_title"
                            android:textColor="@color/white"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/txtArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/default_track_artist"
                            android:textColor="@color/muted"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/txtListeners"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="@string/station_status_unknown"
                            android:textColor="@color/green_neon"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtConnectionStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/playback_connecting"
                            android:textColor="@color/muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- PLAY / PAUSE BUTTON -->
                    <Button
                        android:id="@+id/btnPlayPause"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/button_orange"
                        android:letterSpacing="0.08"
                        android:minHeight="58dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:text="@string/play_live"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <!-- RETRY BUTTON -->
                    <Button
                        android:id="@+id/btnRetryStream"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/button_cyber"
                        android:minHeight="48dp"
                        android:text="@string/retry_stream"
                        android:textColor="@color/purple_neon"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- EXPLORE SECTION -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnWebsite"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/button_cyber"
                            android:minHeight="48dp"
                            android:text="@string/website"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <Space
                            android:layout_width="10dp"
                            android:layout_height="1dp" />

                        <Button
                            android:id="@+id/btnVisuals"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/button_cyber"
                            android:minHeight="48dp"
                            android:text="@string/visuals"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/native_features"
                        android:textColor="@color/muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </ScrollView>

            <!-- TAB 2: CHAT TAB (GREEN ROOM LIVE CHAT) -->
            <LinearLayout
                android:id="@+id/layoutChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Chat Header -->
                <LinearLayout
                    android:id="@+id/chatHeaderBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/panel"
                    android:gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="4dp"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtChatStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:letterSpacing="0.06"
                            android:text="@string/chat_connected"
                            android:textColor="@color/green_neon"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/txtChatUsersCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● 1 in chat"
                            android:textColor="@color/muted"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnChatRules"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/reaction_pill_bg"
                        android:minWidth="0dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/chat_rules_btn"
                        android:textColor="@color/purple_neon"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btnChatProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/button_cyber"
                        android:minWidth="0dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="@string/chat_profile_btn"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Messages List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerChatMessages"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="vertical" />

                <!-- Quick Reactions Bar -->
                <LinearLayout
                    android:id="@+id/layoutReactions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp">

                    <Button
                        android:id="@+id/btnReactFire"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/reaction_pill_bg"
                        android:text="🔥"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnReactSkull"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/reaction_pill_bg"
                        android:text="💀"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnReactHeart"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/reaction_pill_bg"
                        android:text="💜"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnReactBolt"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:background="@drawable/reaction_pill_bg"
                        android:text="⚡"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/btnReactBass"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/reaction_pill_bg"
                        android:text="🔊"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Message Compose Input Bar -->
                <LinearLayout
                    android:id="@+id/layoutCompose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp">

                    <EditText
                        android:id="@+id/editChatMessage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/chat_input_background"
                        android:hint="@string/chat_input_hint"
                        android:imeOptions="actionSend"
                        android:inputType="textCapSentences|textMultiLine"
                        android:maxLines="3"
                        android:minHeight="44dp"
                        android:paddingStart="14dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/white"
                        android:textColorHint="@color/muted"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnSendMessage"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/button_orange"
                        android:contentDescription="@string/chat_send"
                        android:padding="10dp"
                        android:src="@drawable/ic_send" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- BOTTOM NAVIGATION BAR (Seamless Tab Navigation) -->
        <LinearLayout
            android:id="@+id/mainBottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_nav_bg"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:id="@+id/navTabRadio"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/tab_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgTabRadioIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_radio" />

                <TextView
                    android:id="@+id/txtTabRadioLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/tab_radio"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/navTabChat"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/tab_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imgTabChatIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chat" />

                <TextView
                    android:id="@+id/txtTabChatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:letterSpacing="0.08"
                    android:text="@string/tab_chat"
                    android:textColor="@color/muted"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
