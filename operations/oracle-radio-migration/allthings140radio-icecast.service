[Unit]
Description=AllThings140Radio Icecast audio server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=allthings140radio
Group=allthings140radio
ExecStart=/usr/local/bin/icecast -c /etc/allthings140radio/icecast.xml
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/allthings140radio

[Install]
WantedBy=multi-user.target
