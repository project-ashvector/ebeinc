{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allthings140-live-chat",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "SUPABASE_URL": "https://dtvnlpgtmrbnpecsapsv.supabase.co",
    "SUPABASE_PUBLIC_KEY": "sb_publishable_rSf3FiaFsk2zZ37GU0zmzA_2cNQmVJQ"
  },
  "routes": [
    { "pattern": "chat.ebeinc.online", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
